# Copy to `.env` and fill in. NEVER commit the filled-in file.
#   cp .env.example .env
#
# docker-compose.yml reads this file automatically.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=paperswipe
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=paperswipe
POSTGRES_PORT=5432

# Used by the backend when run OUTSIDE Docker (tests, `uvicorn` on the host).
# Inside Docker Compose the host is `db`, not `localhost` — compose sets that itself.
DATABASE_URL=postgresql+asyncpg://paperswipe:change-me-locally@localhost:5432/paperswipe

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-value-do-not-use-this-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_PORT=8000

# Comma-separated allowlist. "*" is for local development ONLY — set real
# origins in production.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Semantic Scholar
# ---------------------------------------------------------------------------
# OPTIONAL. The public endpoint works without a key, but is rate-limited to
# roughly 1 request/second shared across all anonymous callers — expect the
# feed to fall back to cached papers. Request a key at:
#   https://www.semanticscholar.org/product/api#api-key
# Leave blank to run keyless.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=12
SEMANTIC_SCHOLAR_MAX_RETRIES=2
SEMANTIC_SCHOLAR_BATCH_LIMIT=40
