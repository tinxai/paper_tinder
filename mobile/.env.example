# Copy to `.env`. Expo exposes only EXPO_PUBLIC_*-prefixed variables to the app.
#
#   cp .env.example .env
#
# NOTE: EXPO_PUBLIC_* values are embedded in the JS bundle and are readable by
# anyone with the app. Never put a secret here — the backend holds the secrets.

# --- iOS Simulator / Android emulator on the same machine ---
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Physical iPhone ---
# A phone cannot reach your computer at "localhost". Use your Mac's LAN IP,
# with the phone on the same Wi-Fi network. Find it with:
#   ipconfig getifaddr en0
# then set, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# --- Android emulator (if localhost does not resolve) ---
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
